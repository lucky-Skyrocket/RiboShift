  "license": "https://creativecommons.org/licenses/by/4.0/",
  "keywords": [
    "RNA-ligand interactions",
    "RNA-targeted drug discovery",
    "benchmark dataset",
    "distribution shift",
    "scaffold split",
    "dataset curation",
    "molecular machine learning"
  ],
